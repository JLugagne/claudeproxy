server:
  listen: 127.0.0.1:8787
  log_level: info          # debug | info | warn | error
  log_format: text         # text | json
  read_header_timeout: 10s
  idle_timeout: 120s
  shutdown_timeout: 30s

# Request usage is recorded to SQLite, keyed by project and session, and is
# enabled by default (opt-out). Set disabled: true to turn it off, or path to
# choose the database file. In Docker, point path at a writable mount (compose
# binds ./data to /var/lib/claudeproxy).
metrics:
  disabled: false
  path: /var/lib/claudeproxy/usage.db

proxy:
  max_body_bytes: 67108864 # 64 MiB, Messages API bodies are buffered to read the model
  # Receives requests without a model (GET /v1/models, telemetry...) and
  # models no route matches. Leave empty to reject unmatched models.
  default_provider: anthropic

  # A provider speaks the Anthropic Messages API (/v1/messages) unless it sets
  # format: openai-chat, in which case claudeproxy translates requests and
  # responses (streaming and tool calls included) to OpenAI chat completions.
  # auth:
  #   passthrough  forward the client's credentials untouched (Anthropic only!)
  #   bearer       Authorization: Bearer <api_key>, client credentials removed
  #   x-api-key    x-api-key: <api_key>, client credentials removed
  # api_key, base_url and header values support ${ENV_VAR}.
  providers:
    anthropic:
      base_url: https://api.anthropic.com
      auth: passthrough

    # The providers below are disabled: uncomment one, its routes and set its
    # API key to route other models through it.

    # OpenCode Go serves its Anthropic Messages models (minimax-m3,
    # qwen3.8-max, qwen3.8-flash, qwen3.7-plus...) under /anthropic.
    # Claude Code sends mid-conversation system messages (tool additions,
    # reasoning effort) that non-Claude models reject:
    # flatten_mid_conversation_updates moves them to the request level.
    # Claude identity is stripped automatically for non-passthrough
    # providers: Authorization/x-api-key/Cookie, User-Agent, anthropic-beta,
    # x-stainless-* and x-anthropic-* headers, plus the body's metadata
    # object and billing attribution block. Set keep_claude_metadata: true
    # to keep the body's metadata and attribution.
    # opencode-go:
    #   base_url: https://opencode.ai/inference/go/anthropic
    #   auth: x-api-key
    #   api_key: ${OPENCODE_API_KEY}
    #   flatten_mid_conversation_updates: true

    # OpenCode Go serves deepseek-v4.1-flash, glm-*, kimi-*, mimo-*... on its
    # OpenAI chat-completions endpoint; the translator adds /v1/chat/completions.
    # OpenCode Go wants a distinctive User-Agent, and the session id of Claude
    # Code is forwarded as x-opencode-session.
    # opencode-go-openai:
    #   base_url: https://opencode.ai/inference/go/openai
    #   format: openai-chat
    #   auth: bearer
    #   api_key: ${OPENCODE_API_KEY}
    #   flatten_mid_conversation_updates: true
    #   headers:
    #     User-Agent: claudeproxy/1.0

    # OpenRouter serves the Anthropic Messages API under /api (/api/v1/messages)
    # with a Bearer key, for models named by their "vendor/model" slug
    # (anthropic/claude-opus-5, deepseek/deepseek-v4.1-flash, openrouter/auto...).
    # openrouter:
    #   base_url: https://openrouter.ai/api
    #   auth: bearer
    #   api_key: ${OPENROUTER_API_KEY}
    #   flatten_mid_conversation_updates: true

    # Same models on OpenRouter's OpenAI chat-completions endpoint, for models
    # whose Anthropic translation falls short; the translator adds
    # /v1/chat/completions.
    # openrouter-openai:
    #   base_url: https://openrouter.ai/api
    #   format: openai-chat
    #   auth: bearer
    #   api_key: ${OPENROUTER_API_KEY}
    #   flatten_mid_conversation_updates: true

  # First match wins. "match" is a glob ('*' spans '/', '?' is one char),
  # "regex" is RE2. "model" renames the model upstream; $1, $2... refer to
  # the wildcards / capture groups.
  routes:
    # Divert a Claude tier: Claude Code believes it uses Haiku.
    # - match: "claude-haiku-*"
    #   provider: opencode-go
    #   model: qwen3.8-flash

    - match: "claude-*"
      provider: anthropic

    # OpenRouter, selected with an "openrouter/" prefix that is stripped
    # upstream: "openrouter/deepseek/deepseek-v4.1-flash" is sent as
    # "deepseek/deepseek-v4.1-flash" (and "openrouter/openrouter/auto" as
    # "openrouter/auto").
    # - match: "openrouter/*"
    #   provider: openrouter
    #   model: $1

    # OpenCode Go models served on the OpenAI chat-completions endpoint.
    # - regex: "^(deepseek-|glm-|kimi-|longcat-|mimo-|step-|hy[0-9]|beam-|minimax-m3\\.1)"
    #   provider: opencode-go-openai

    # Every other model goes to OpenCode Go, e.g. "minimax-m3".
    # - match: "*"
    #   provider: opencode-go
